// ======================================================
// SEGUIDOR DE LINHA - 2 SENSORES ANALÓGICOS + CONTROLE PD
// ======================================================


// -------------------- SENSORES --------------------

#define pinSensorEsquerdo A1
#define pinSensorDireito A2


// -------------------- MOTORES --------------------

// Motor esquerdo
#define ENA 5
#define IN1 4
#define IN2 3

// Motor direito
#define ENB 9
#define IN3 8
#define IN4 10


// -------------------- CONFIGURAÇÕES --------------------

int velocidadeBase = 200;

// Valores iniciais para calibração
float Kp = 25;
float Kd = 10;

// Valor provisório.
// Deve ser ajustado depois dos testes dos sensores.
int limiteLinhaPerdida = 15;


// -------------------- LEITURA DOS SENSORES --------------------

int sensorEsquerdo = 0;
int sensorDireito = 0;


// -------------------- CONTROLE PD --------------------

float erro = 0;
float erroAnterior = 0;

float proporcional = 0;
float derivada = 0;
float correcao = 0;


// -------------------- VELOCIDADES --------------------

int velocidadeEsquerda = 0;
int velocidadeDireita = 0;

// -----------------------------------------------------
void setup()
{
    pinMode(pinSensorEsquerdo, INPUT);
    pinMode(pinSensorDireito, INPUT);


    pinMode(ENA, OUTPUT);
    pinMode(IN1, OUTPUT);
    pinMode(IN2, OUTPUT);

    pinMode(ENB, OUTPUT);
    pinMode(IN3, OUTPUT);
    pinMode(IN4, OUTPUT);


    Serial.begin(9600);
}


void loop()
{

    sensorEsquerdo = analogRead(pinSensorEsquerdo);
    sensorDireito = analogRead(pinSensorDireito);

    int somaLeituras = sensorEsquerdo + sensorDireito;


    if(somaLeituras < limiteLinhaPerdida)
    {
        parar();

        Serial.println("LINHA PERDIDA");

        return;
    }


    // ==============================================
    // CÁLCULO DO ERRO
    // ==============================================

    /*
       Sensor esquerdo = peso -1
       Sensor direito  = peso +1

       O resultado fica aproximadamente entre:

       -1 = linha para esquerda
        0 = centralizado
       +1 = linha para direita
    */

    erro =
    (
        sensorEsquerdo * -1.0 +
        sensorDireito  *  1.0
    )
    / somaLeituras;

    proporcional = Kp * erro;

    derivada = Kd * (erro - erroAnterior);

    correcao = proporcional + derivada;


    velocidadeEsquerda = velocidadeBase + correcao;
    velocidadeDireita = velocidadeBase - correcao;


    // Limita PWM entre 0 e 255

    velocidadeEsquerda =
        constrain(velocidadeEsquerda, 0, 255);

    velocidadeDireita =
        constrain(velocidadeDireita, 0, 255);


    andar(
        velocidadeEsquerda,
        velocidadeDireita
    );


    // ==============================================
    // MONITOR SERIAL
    // ==============================================

    Serial.print("Sensor E: ");
    Serial.print(sensorEsquerdo);

    Serial.print(" | Sensor D: ");
    Serial.print(sensorDireito);

    Serial.print(" | Erro: ");
    Serial.print(erro);

    Serial.print(" | Correcao: ");
    Serial.print(correcao);

    Serial.print(" | Esq: ");
    Serial.print(velocidadeEsquerda);

    Serial.print(" | Dir: ");
    Serial.println(velocidadeDireita);

    erroAnterior = erro;
}

void andar(int velocidadeEsquerda, int velocidadeDireita)
{
    // Motores sempre no sentido de frente

    digitalWrite(IN1, HIGH);
    digitalWrite(IN2, LOW);

    digitalWrite(IN3, HIGH);
    digitalWrite(IN4, LOW);


    // Controle de velocidade via PWM

    analogWrite(ENA, velocidadeEsquerda);
    analogWrite(ENB, velocidadeDireita);
}


void parar()
{
    digitalWrite(IN1, LOW);
    digitalWrite(IN2, LOW);

    digitalWrite(IN3, LOW);
    digitalWrite(IN4, LOW);

    analogWrite(ENA, 0);
    analogWrite(ENB, 0);
}
