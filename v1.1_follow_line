// Mudei os sensores para pinagem analógica
#define pinSensor1 A4
#define pinSensor2 A3
#define pinSensor3 A2
#define pinSensor4 A1
#define pinSensor5 A0

/* Configuração dos motores */
#define ENA 3
#define IN1 5
#define IN2 6

#define ENB 9
#define IN3 7
#define IN4 8


// ========================
// VARIÁVEIS DOS SENSORES
// ========================

int sensorExtremaEsquerda = 0;
int sensorMeiaEsquerda = 0;
int sensorFrente = 0;
int sensorMeiaDireita = 0;
int sensorExtremaDireita = 0;


// ========================
// CONTROLE
// ========================

int velocidadeBase = 180;

// Velocidade mínima para impedir
// que uma das rodas pare completamente
int velocidadeMinima = 80;

// Quanto maior, mais forte será a correção
float Kp = 40;

float erro = 0;
float correcao = 0;

int velocidadeEsquerda = 0;
int velocidadeDireita = 0;


void setup()
{
    // Sensores
    pinMode(pinSensor1, INPUT);
    pinMode(pinSensor2, INPUT);
    pinMode(pinSensor3, INPUT);
    pinMode(pinSensor4, INPUT);
    pinMode(pinSensor5, INPUT);

    // Motor esquerdo
    pinMode(ENA, OUTPUT);
    pinMode(IN1, OUTPUT);
    pinMode(IN2, OUTPUT);

    // Motor direito
    pinMode(ENB, OUTPUT);
    pinMode(IN3, OUTPUT);
    pinMode(IN4, OUTPUT);

    Serial.begin(9600);
}


void loop()
{
    // ========================
    // LEITURA DOS SENSORES
    // ========================

    sensorExtremaEsquerda = analogRead(pinSensor1);
    sensorMeiaEsquerda = analogRead(pinSensor2);
    sensorFrente = analogRead(pinSensor3);
    sensorMeiaDireita = analogRead(pinSensor4);
    sensorExtremaDireita = analogRead(pinSensor5);


    // ========================
    // SOMA DOS SENSORES
    // ========================

    long soma =
        sensorExtremaEsquerda +
        sensorMeiaEsquerda +
        sensorFrente +
        sensorMeiaDireita +
        sensorExtremaDireita;


    // ========================
    // CÁLCULO DO ERRO
    // ========================

    if (soma > 0)
    {
        erro =
        (
            sensorExtremaEsquerda * -2.0 +
            sensorMeiaEsquerda * -1.0 +
            sensorFrente * 0.0 +
            sensorMeiaDireita * 1.0 +
            sensorExtremaDireita * 2.0
        ) / soma;
    }


    // ========================
    // CORREÇÃO PROPORCIONAL
    // ========================

    correcao = Kp * erro;


    // ========================
    // LIMITA A CORREÇÃO
    // ========================

    correcao = constrain(
        correcao,
        -(velocidadeBase - velocidadeMinima),
         (velocidadeBase - velocidadeMinima)
    );


    // ========================
    // VELOCIDADE DOS MOTORES
    // ========================

    velocidadeEsquerda = velocidadeBase + correcao;
    velocidadeDireita = velocidadeBase - correcao;


    // Impede que alguma roda chegue a 0
    velocidadeEsquerda =
        constrain(velocidadeEsquerda, velocidadeMinima, 255);

    velocidadeDireita =
        constrain(velocidadeDireita, velocidadeMinima, 255);


    // ========================
    // SENTIDO DOS MOTORES
    // ========================

    // Motor esquerdo para frente
    digitalWrite(IN1, HIGH);
    digitalWrite(IN2, LOW);

    // Motor direito para frente
    digitalWrite(IN3, LOW);
    digitalWrite(IN4, HIGH);


    // ========================
    // CONTROLE DA VELOCIDADE
    // ========================

    analogWrite(ENA, velocidadeEsquerda);
    analogWrite(ENB, velocidadeDireita);


    // ========================
    // MONITOR SERIAL
    // ========================

    Serial.print("EE: ");
    Serial.print(sensorExtremaEsquerda);

    Serial.print(" | ME: ");
    Serial.print(sensorMeiaEsquerda);

    Serial.print(" | C: ");
    Serial.print(sensorFrente);

    Serial.print(" | MD: ");
    Serial.print(sensorMeiaDireita);

    Serial.print(" | ED: ");
    Serial.print(sensorExtremaDireita);

    Serial.print(" | Erro: ");
    Serial.print(erro, 2);

    Serial.print(" | Correcao: ");
    Serial.print(correcao);

    Serial.print(" | Motor E: ");
    Serial.print(velocidadeEsquerda);

    Serial.print(" | Motor D: ");
    Serial.println(velocidadeDireita);

    delay(10);
}
