// Mudei os sensores para pinagem analógica
#define pinSensor1 A4
#define pinSensor2 A3
#define pinSensor3 A2
#define pinSensor4 A1
#define pinSensor5 A0

/* Mantive a configuração dos motores, igual nas versões anteriores */
#define ENA 3 // Alterado para porta PMW
#define IN1 5
#define IN2 6


#define ENB 9
#define IN3 7
#define IN4 8

/*
Confirme se ENA realmente é o motor direito

Sua função considera:

ENA = direita
ENB = esquerda

Mas isso precisa coincidir com o hardware.

Não confie apenas no nome.

Faça dois testes:

ENA ligado sozinho: qual roda gira?

ENB ligado sozinho: qual roda gira?

Depois disso, defina definitivamente qual é esquerda e qual é direita.

Testar trocar as portas do ENA e ENB para respectivamente 5 e 6, eles possuem mais frequencia pmw
portas normais -> 490 hz
portas 5 e 6 arduino uno -> 980 hz
*/


// Sensores - Valores alterados para int já o analogwrite lê apenas numeros inteiros/tipo de dados permitidos inteiros
int sensorExtremaEsquerda = 0;
int sensorMeiaEsquerda = 0;
int sensorMeiaDireita = 0;
int sensorExtremaDireita = 0;
int sensorFrente = 0;

/*
Normalize os sensores antes da média ponderada

Depois da calibração, transforme todos para uma escala comum, por exemplo conceitualmente:

0 = nenhuma linha

1000 = linha completamente detectada

Assim a média ponderada representa realmente a posição da linha e não diferenças elétricas entre os sensores.
*/

// Constantes do PID
float Kp = 15;
float Ki = 0;
float Kd = 5;
/*
E nesse ponto seu Ki = 0 é razoável.

Para seguidores de linha rápidos, normalmente é muito mais fácil começar com um:

PD

ou seja:

P + D

Primeiro faça o robô funcionar muito bem com:

proporcional;
derivativo.

Depois avalie se realmente existe necessidade de integral.

Integral mal regulado pode piorar curvas e criar oscilação.
*/

/*
O derivativo deveria considerar o tempo

Atualmente você considera:

erro atual - erro anterior

Mas existe uma diferença entre mudar 1 unidade em:

2 ms;
10 ms;
100 ms.

Matematicamente o derivativo deveria considerar:

mudança do erro / mudança do tempo

Isso torna o PID muito menos dependente da velocidade de execução do programa.
*/

// Variáveis para cálculo
float mediaPonderada = 0;
float erroAnterior = 0;
float correcao = 0;

// Variáveis de velocidade - Valores alterados para int pelo mesmo motivo dos sensores
int velocidadeEsquerda = 0;
int velocidadeDireita = 0;

int velocidadeBase = 200;

/*
Seu integral atual não é exatamente o integral PID clássico

Você guarda apenas os últimos:

5 erros

Isso significa que você possui uma espécie de janela móvel.

Com delay(5), aproximadamente:

5 × 5 ms = 25 ms

de histórico, fora o tempo de execução.

É extremamente pouco.

Além disso, no PID tradicional, integral está relacionado a:

erro × tempo

e não apenas à soma crua dos últimos erros.
*/

// Controle da memória dos erros
int contador = 0;
float guardaErros[5] = {0, 0, 0, 0, 0};



void setup()
{
    // Configuração dos sensores como entrada
    pinMode(pinSensor1, INPUT);
    pinMode(pinSensor2, INPUT);
    pinMode(pinSensor3, INPUT);
    pinMode(pinSensor4, INPUT);
    pinMode(pinSensor5, INPUT);

    // Configuração dos motores
    pinMode(ENA, OUTPUT);
    pinMode(IN1, OUTPUT);
    pinMode(IN2, OUTPUT);

    pinMode(ENB, OUTPUT);
    pinMode(IN3, OUTPUT);
    pinMode(IN4, OUTPUT);

    Serial.begin(9600);
}

/*
 * Mantém os dois motores andando para frente.
 * A velocidade de cada motor determina a correção da trajetória.
 */
void andar(int velocidadeDireita, int velocidadeEsquerda)
{
    digitalWrite(IN1, HIGH);
    digitalWrite(IN2, LOW);

    digitalWrite(IN3, HIGH);
    digitalWrite(IN4, LOW);

    analogWrite(ENA, velocidadeDireita);
    analogWrite(ENB, velocidadeEsquerda);
}

void parar()
{
    digitalWrite(IN1, LOW);
    digitalWrite(IN2, LOW);

    digitalWrite(IN3, LOW);
    digitalWrite(IN4, LOW);

    analogWrite(ENA, 0);
    analogWrite(ENB, 0);
}

void loop()
{
    // Calcula o erro baseado nos sensores
    float erro = calcularErrosSensor();

    // Termo proporcional
    float proporcional = Kp * erro;

    // Calcula a soma dos erros acumulados
    float somaDosErros = calcularIntegral(erro);

    // Termo integral
    float integral = Ki * somaDosErros;

    // Termo derivativo
    float derivada = Kd * (erro - erroAnterior);

    // Correção total do PID
    correcao = proporcional + integral;

    /*
     * Se a correção for positiva:
     * - aumenta a velocidade de um motor
     * - diminui a velocidade do outro
     *
     * Se a correção for negativa:
     * - acontece o contrário.
     */

    velocidadeDireita = velocidadeBase + correcao;
    velocidadeEsquerda = velocidadeBase - correcao;

    // Limita a velocidade entre 0 e 255
    velocidadeDireita = constrain(velocidadeDireita, 0, 255);
    velocidadeEsquerda = constrain(velocidadeEsquerda, 0, 255);

    // Envia as velocidades para os motores
    andar(velocidadeDireita, velocidadeEsquerda);

    // Atualiza o erro anterior para o próximo ciclo
    erroAnterior = erro;

    // Pequeno intervalo para evitar leituras excessivamente rápidas
    delay(5);
}

float calcularErrosSensor()
{
    // Leitura dos sensores
    sensorExtremaEsquerda = analogRead(pinSensor1); // peso -2
    sensorMeiaEsquerda = analogRead(pinSensor2);    // peso -1
    sensorFrente = analogRead(pinSensor5);          // peso 0
    sensorMeiaDireita = analogRead(pinSensor3);     // peso +1
    sensorExtremaDireita = analogRead(pinSensor4);  // peso +2

    // Soma das leituras
    float somaLeituras =
        sensorExtremaEsquerda +
        sensorMeiaEsquerda +
        sensorFrente +
        sensorMeiaDireita +
        sensorExtremaDireita;

    /*
     * Caso todas as leituras sejam muito baixas,
     * evita divisão por zero e para o robô.
     */
    if (somaLeituras < 15)
    {
        parar();
        return erroAnterior;
    }

    // Média ponderada = erro
    mediaPonderada =
        (
            sensorExtremaEsquerda * -2 +
            sensorMeiaEsquerda * -1 +
            sensorMeiaDireita * 1 +
            sensorExtremaDireita * 2
        ) / somaLeituras;

    return mediaPonderada;
}

float calcularIntegral(float erro)
{
    // Armazena o erro atual
    guardaErros[contador] = erro;

    // Avança para a próxima posição
    contador++;

    // Número de posições do vetor
    int tamanhoVetor = sizeof(guardaErros) / sizeof(guardaErros[0]);

    // Volta para o início quando chegar ao final
    if (contador >= tamanhoVetor)
    {
        contador = 0;
    }

    // Soma os erros armazenados
    float somaErros = 0;

    for (int i = 0; i < tamanhoVetor; i++)
    {
        somaErros += guardaErros[i];
    }

    return somaErros;
}
